# Copiar como .env.local (no se versiona). Sin prefijo VITE_: la clave se queda en el servidor de desarrollo.
# Crear una clave (desde WSL, en la raíz del repo):
#   sh services/gateway/scripts/new-api-key.sh org-alpha "dashboard" | tail -1 | sed 's/^/VERITHREAT_API_KEY=/' > dashboard/.env.local
VERITHREAT_API_KEY=
# Opcional: dónde escucha el Gateway
GATEWAY_URL=http://127.0.0.1:8080
